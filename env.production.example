POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=hcm_ai_db

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
BACKEND_CORS_ORIGINS=https://your-domain.com

# Azure OpenAI agent. Keep the key in your deployment secret store.
AI_PROVIDER=azure
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AI_HISTORY_MESSAGE_LIMIT=12
AI_MAX_TOOL_CALLS=3

# Leave empty when frontend and API are served from the same domain.
VITE_API_URL=
FRONTEND_PORT=80

CHECKIN_START_TIME=06:00
CHECKIN_END_TIME=23:00
CHECKOUT_MIN_TIME=16:00
STANDARD_CHECKIN_TIME=08:00
STANDARD_CHECKOUT_TIME=17:30
AUTO_CHECKOUT_TIME=23:59
